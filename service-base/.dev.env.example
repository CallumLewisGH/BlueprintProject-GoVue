# Database Configuration
ENVIRONMENT=dev
DATABASE_CONNECTION_STRING=postgresql://postgres:changeme@localhost:5432/app_db_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
PORT=8080
BACKEND_DOMAIN=localhost:8080
BACKEND_URL=http://localhost:8080

# Google OAuth Configuration
GIN_SESSION_SECRET=changeme-generate-a-random-secret
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# JWT Configuration
JWT_SECRET=changeme-generate-a-random-secret
SESSION_KEY=changeme-generate-a-random-secret

# Application Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_DOMAIN=localhost:5173

# Image storage (Google Cloud Storage) - uncomment once the bucket exists
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Docker/Testing
DOCKER_CONTAINER_NAME=app-dev

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379

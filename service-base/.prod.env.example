# Database Configuration
DATABASE_CONNECTION_STRING=changeme
DATABASE_USER=changeme
DATABASE_PASSWORD=changeme
ENVIRONMENT=prod
PORT=8080
BACKEND_URL=changeme

# Google OAuth Configuration
SESSION_KEY=changeme-generate-a-random-secret
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# JWT Configuration
JWT_SECRET=changeme-generate-a-random-secret

# Application Configuration
FRONTEND_URL=changeme
FRONTEND_DOMAIN=changeme
# Comma-separated list of allowed origins. Required - the server refuses to
# start without this set in any non-dev environment.
CORS_ALLOWED_ORIGINS=changeme

# Image storage (Google Cloud Storage)
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_EMAIL=

# Outbound email (SMTP) - see integrations/email.go
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379
